{
  "name": "plogr-workflow",
  "version": "1.0.0",
  "description": "Initialize Herdr multi-agent workflow projects — zero-collision AI orchestration by Plogr",
  "bin": {
    "plogr": "./bin/cli.js",
    "plogr-workflow": "./bin/cli.js"
  },
  "scripts": {
    "test": "npm run test:formal",
    "test:formal": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tests_formal_audit/Run-All-Formal-Tests.ps1",
    "test:contract": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tests_formal_audit/Test-WorkflowContract.ps1",
    "pack:check": "npm pack --dry-run --json"
  },
  "files": [
    "bin/",
    "scripts/",
    "bundled_skills/",
    "skills/",
    "references/",
    "agents/",
    "SKILL.md",
    "schemas/",
    "templates/"
  ],
  "keywords": [
    "plogr",
    "herdr",
    "ai",
    "agent",
    "workflow",
    "orchestrator",
    "multi-agent",
    "claude",
    "codex",
    "opencode",
    "gemini",
    "audit-suite",
    "mattpocock"
  ],
  "author": "plogr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/plogr-first/workflow.git",
    "directory": "herdr-skill"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
