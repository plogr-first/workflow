{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "issues"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "issues": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "state", "commit_sha", "worktree", "branch", "evidence"], "properties": {"id": {"type": "string"}, "state": {"const": "done"}, "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"}, "worktree": {"type": "string"}, "branch": {"type": "string"}, "evidence": {"type": "object", "required": ["result", "outcome"]}}}}
  }
}
